#!/usr/bin/env bash
# Claude Code PostToolUse hook: show each file Claude edits in Zed at the changed
# line, without taking focus. `zed-follow off` pauses it, `zed-follow on` resumes.
set -euo pipefail

paused="${XDG_STATE_HOME:-$HOME/.local/state}/zed-follow-paused"
case "${1:-}" in
  off) mkdir -p "${paused%/*}" && touch "$paused"; exit ;;
  on) rm -f "$paused"; exit ;;
esac
[[ -e "$paused" ]] && exit 0

IFS=$'\t' read -r file line < <(jq -r '
  (.tool_response.structuredPatch[0]? // null) as $hunk
  | [ .tool_input.file_path,
      (if $hunk then $hunk.newStart + ([$hunk.lines[] | select(startswith("-") | not) | startswith("+")] | index(true) // 0)
       else 1 end) ]
  | @tsv')
[[ -f "$file" ]] || exit 0

open -g "zed://file$(jq -rn --arg p "$file" '$p | split("/") | map(@uri) | join("/")'):$line"
