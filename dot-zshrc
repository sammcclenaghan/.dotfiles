alias ls="ls -G"

eval "$("$HOME/.local/bin/mise" activate zsh)"
eval "$(starship init zsh)"

autoload -Uz compinit && compinit

plugins="$HOMEBREW_PREFIX/share"
source "$plugins/fzf-tab/fzf-tab.zsh"
source "$plugins/zsh-autosuggestions/zsh-autosuggestions.zsh"
source "$plugins/zsh-fast-syntax-highlighting/fast-syntax-highlighting.plugin.zsh"
unset plugins

# fzf-tab: match case-insensitively, preview directories on cd
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'
zstyle ':completion:*' menu no
zstyle ':fzf-tab:complete:cd:*' fzf-preview 'ls -G $realpath'

# cd learns where you go: `cd elev8` jumps to the best match, `cdi` picks with fzf.
# zoxide wants to be initialized after compinit.
eval "$(zoxide init zsh --cmd cd)"

# Records each Rex pane's last command so rexurrect can restore it
source "$HOME/.config/zsh/rexurrect.plugin.zsh"

# Kiro terminal integration (work)
[[ "$TERM_PROGRAM" == "kiro" ]] && . "$(kiro --locate-shell-integration-path zsh)"

# Machine-local secrets (git-ignored)
[ -f ~/.zshrc.local ] && source ~/.zshrc.local
