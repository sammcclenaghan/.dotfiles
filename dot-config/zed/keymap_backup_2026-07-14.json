[
  // ─── Normal mode ──────────────────────────────────────
  {
    "context": "Editor && vim_mode == normal && !VimWaiting && !menu",
    "bindings": {
      // pane navigation
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-j": "workspace::ActivatePaneDown",

      // buffer navigation
      "shift-h": "pane::ActivatePreviousItem",
      "shift-l": "pane::ActivateNextItem",

      // search
      "space space": "file_finder::Toggle",
      "space s f": "file_finder::Toggle",
      "space s g": "pane::DeploySearch",
      "space /": "buffer_search::Deploy",

      // file tree
      "space e": "pane::RevealInProjectPanel",

      // lsp
      "g d": "editor::GoToDefinition",
      "g D": "editor::GoToDefinitionSplit",
      "g r": "editor::FindAllReferences",
      "g i": "editor::GoToImplementation",
      "g I": "editor::GoToImplementationSplit",
      "K": "editor::GoToDefinition",
      "space c a": "editor::ToggleCodeActions",
      "space .": "editor::ToggleCodeActions",
      "space r n": "editor::Rename",
      "space l f": "editor::Format",

      // diagnostics
      "] d": "editor::GoToDiagnostic",
      "[ d": "editor::GoToPreviousDiagnostic",
      "space x x": "diagnostics::Deploy",

      // git hunks
      "] c": "editor::GoToHunk",
      "[ c": "editor::GoToPreviousHunk",

      // toggles
      "space t i": "editor::ToggleInlayHints",
      "space t n": "editor::ToggleRelativeLineNumbers",
      "space z": "workspace::ToggleZoom",

      // splits
      "\\": ["pane::SplitRight", {}],
      "-": ["pane::SplitDown", {}],

      // buffer management
      "space b": "tab_switcher::Toggle",
      "space p": "command_palette::Toggle",
      "space o": "outline::Toggle",
      "space q": "pane::CloseActiveItem",
      "space w": "workspace::Save",
      "space g g": "git_panel::ToggleFocus",
    },
  },

  // ─── Normal + Visual ──────────────────────────────────
  {
    "context": "Editor && (vim_mode == normal || vim_mode == visual) && !VimWaiting && !menu && !terminal",
    "bindings": {
      // move lines
      "alt-j": "editor::MoveLineDown",
      "alt-k": "editor::MoveLineUp",

      "space m p": "markdown::OpenPreview",
      "space m P": "markdown::OpenPreviewToTheSide",
      "space g f": "editor::OpenExcerpts",
    },
  },

  // ─── Insert mode ──────────────────────────────────────
  {
    "context": "Editor && vim_mode == insert && !menu",
    "bindings": { "k j": "vim::NormalBefore" },
  },

  // ─── Edit predictions ─────────────────────────────────
  {
    "context": "Editor && (edit_prediction && showing_completions)",
    "bindings": { "tab": "editor::AcceptEditPrediction" },
  },
  {
    "context": "Editor && edit_prediction",
    "bindings": { "esc": "editor::Cancel" },
  },

  // ─── Terminal ─────────────────────────────────────────
  {
    "context": "Terminal",
    "bindings": {
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-j": "workspace::ActivatePaneDown",
    },
  },

  // ─── Project panel — vim-like ─────────────────────────
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "a": "project_panel::NewFile",
      "A": "project_panel::NewDirectory",
      "r": "project_panel::Rename",
      "d": "project_panel::Delete",
      "x": "project_panel::CollapseSelectedEntry",
      "q": "workspace::ToggleLeftDock",
      "space e": "workspace::ToggleLeftDock",
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-l": "workspace::ActivatePaneRight",
    },
  },
  {
    "bindings": {
      "cmd-shift-a": "agent::Toggle"
    }
  }
]
