// Only settings that differ from Zed's defaults (zed: open default settings).
{
  "disable_ai": true,
  "vim_mode": true,
  "session": { "trust_all_worktrees": true },

  // Appearance
  "theme": {
    "mode": "dark",
    "light": "GitHub Light",
    "dark": "Ember Daily Dark",
  },
  "buffer_font_family": "JetBrains Mono",
  "buffer_font_size": 13,
  "ui_font_family": ".SystemUIFont",
  "ui_font_size": 14,
  "ui_font_weight": 450,
  "unnecessary_code_fade": 0.5,
  "cursor_blink": false,
  "zoomed_padding": false,
  "active_pane_modifiers": { "inactive_opacity": 0.8 },

  // Editing
  "tab_size": 2,
  "soft_wrap": "editor_width",
  "format_on_save": "on",
  "autosave": "on_focus_change",
  "relative_line_numbers": "enabled",
  "vertical_scroll_margin": 8,
  "expand_excerpt_lines": 8,
  "use_smartcase_search": true,
  "vim": {
    "use_smartcase_find": true,
    "toggle_relative_line_numbers": true,
  },
  "which_key": { "enabled": true, "delay_ms": 150 },

  // Chrome: hide what the keymap covers
  "bottom_dock_layout": "full",
  "tabs": { "git_status": true },
  "preview_tabs": { "enable_preview_from_file_finder": true },
  "toolbar": { "quick_actions": false, "selections_menu": false },
  "scrollbar": { "show": "never" },
  "indent_guides": { "enabled": false },
  "gutter": { "runnables": false, "breakpoints": false },
  "title_bar": {
    "show_sign_in": false,
    "show_user_picture": false,
    "show_user_menu": false,
    "show_onboarding_banner": false,
  },
  "status_bar": { "active_language_button": false },
  "project_panel": { "button": false },
  "outline_panel": { "button": false },
  "terminal": { "button": false, "copy_on_select": true },
  "search": { "button": false },
  "debugger": { "button": false },

  // Git
  "git_panel": { "sort_by": "name" },
  "git": {
    "inline_blame": { "delay_ms": 300, "min_column": 180, "location": "status_bar" },
  },
  "command_aliases": {
    "gd": "git::Diff",
    "gb": "git::Branch",
    "gbd": "git::BranchDiff",
    "gp": "git::Push",
    "gcp": "git::CreatePullRequest",
    "tsd": "editor::ToggleSplitDiff",
  },

  // Languages
  "languages": {
    "Ruby": {
      "formatter": "language_server",
      "preferred_line_length": 120,
      "soft_wrap": "preferred_line_length",
      "language_servers": ["ruby-lsp", "rubocop", "!solargraph", "!sorbet", "!steep", "!kanayago"],
    },
    "HTML+ERB": { "language_servers": ["herb", "ruby-lsp"] },
    "ERB": { "language_servers": ["ruby-lsp"] },
    "TypeScript": {
      "formatter": "prettier",
      "language_servers": ["typescript-language-server", "!vtsls"],
      "code_actions_on_format": {
        "source.organizeImports": true,
        "source.fixAll.eslint": true,
      },
    },
    "TSX": {
      "formatter": "prettier",
      "language_servers": ["typescript-language-server", "eslint", "tailwindcss-language-server", "!vtsls"],
    },
  },
  "lsp": {
    "typescript-language-server": {
      "initialization_options": {
        "preferences": {
          "includeInlayParameterNameHints": "none",
          "includeInlayFunctionParameterTypeHints": true,
          "includeInlayVariableTypeHints": false,
          "includeInlayPropertyDeclarationTypeHints": true,
          "includeInlayFunctionLikeReturnTypeHints": true,
          "includeInlayEnumMemberValueHints": true,
          "importModuleSpecifierPreference": "shortest",
          "quotePreference": "single",
        },
        "tsserver": { "maxTsServerMemory": 8192 },
      },
    },
    "rubocop": {
      "binary": {
        "path": "/Users/sammcclenaghan/.local/share/mise/shims/rubocop",
        "arguments": ["--lsp"],
      },
      "settings": { "use_bundler": false },
      "initialization_options": { "safeAutocorrect": true },
    },
    "ruby-lsp": {
      "binary": { "path": "/Users/sammcclenaghan/.local/share/mise/shims/ruby-lsp" },
      "settings": { "use_bundler": true },
      // rubocop's own server reports diagnostics
      "initialization_options": {
        "formatter": "rubocop",
        "enabledFeatures": { "diagnostics": false },
      },
    },
  },
  "auto_install_extensions": {
    "ruby": true,
    "toml": true,
    "sql": true,
    "xml": true,
    "astro": true,
    "github-theme": true,
  },

  // Zed's defaults plus build and tooling output
  "file_scan_exclusions": [
    "**/.git", "**/.svn", "**/.hg", "**/.jj", "**/.sl", "**/.repo", "**/CVS",
    "**/.DS_Store", "**/Thumbs.db", "**/.classpath", "**/.settings",
    "**/node_modules", "**/dist", "**/out", "**/.next", "**/.turbo",
    "**/.husky", "**/.storybook", "**/.vscode", "**/.vscode-test",
    "**/.tap", "**/.nyc_output", "**/report",
  ],
}
