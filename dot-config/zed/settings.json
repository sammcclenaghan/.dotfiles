{
  // ─── Core ─────────────────────────────────────────────
  "icon_theme": {
    "mode": "light",
    "light": "Zed (Default)",
    "dark": "Zed (Default)"
  },
  "base_keymap": "VSCode",
  "vim_mode": true,
  "theme": {
    "mode": "light",
    "light": "One Light",
    "dark": "Base16 Gruvbox dark, hard"
  },
  "telemetry": { "diagnostics": false, "metrics": false },

  // ─── Font ─────────────────────────────────────────────
  "buffer_font_family": "JetBrains Mono",
  "buffer_font_size": 13.0,
  "ui_font_family": "JetBrains Mono",
  "ui_font_size": 13.0,

  // ─── Editor ───────────────────────────────────────────
  "tab_size": 2,
  "relative_line_numbers": "enabled",
  "soft_wrap": "none",
  "format_on_save": "on",
  "autosave": "on_focus_change",
  "current_line_highlight": "all",
  "vertical_scroll_margin": 8,
  "cursor_blink": false,
  "show_wrap_guides": false,
  "hover_popover_delay": 200,
  "unnecessary_code_fade": 0.5,
  "use_smartcase_search": true,
  "seed_search_query_from_cursor": "always",
  "always_treat_brackets_as_autoclosed": true,
  "when_closing_with_no_tabs": "keep_window_open",
  "restore_on_startup": "last_session",

  // ─── Chrome ───────────────────────────────────────────
  "tab_bar": { "show": false },
  "toolbar": { "breadcrumbs": false, "quick_actions": false, "selections_menu": false },
  "scrollbar": { "show": "never" },
  "minimap": { "show": "never" },
  "indent_guides": { "enabled": false },
  "active_pane_modifiers": { "border_size": 0.0 },
  "use_system_window_tabs": false,
  "bottom_dock_layout": "contained",
  "title_bar": {
    "show_menus": false,
    "show_sign_in": false,
    "show_user_picture": false,
    "show_user_menu": false,
    "show_onboarding_banner": false,
    "show_project_items": true,
    "show_branch_name": true,
  },
  "status_bar": {
    "cursor_position_button": true,
    "active_language_button": false,
    "line_endings_button": false,
  },

  // ─── Gutter ───────────────────────────────────────────
  "gutter": { "folds": false, "runnables": false, "breakpoints": false },
  "git": { "git_gutter": "hide" },
  "diagnostics": { "inline": { "enabled": true, "padding": 15 } },

  // ─── Panels ───────────────────────────────────────────
  "project_panel": {
    "button": false,
    "indent_size": 15,
    "entry_spacing": "standard",
    "auto_fold_dirs": true,
    "indent_guides": { "show": "never" },
    "scrollbar": { "show": "never" },
  },
  "outline_panel": { "button": false },
  "terminal": { "button": false, "font_size": 13.0, "copy_on_select": true },
  "search": { "button": false, "center_on_match": true },
  "debugger": { "button": false },
  "file_finder": { "modal_max_width": "medium" },

  // ─── Inlay Hints ──────────────────────────────────────
  "inlay_hints": {
    "enabled": false,
    "show_type_hints": true,
    "show_parameter_hints": true,
    "show_other_hints": true,
    "show_background": true,
    "edit_debounce_ms": 700,
    "scroll_debounce_ms": 50,
  },

  // ─── Edit Predictions ─────────────────────────────────
  "edit_predictions": { "provider": "zed", "mode": "subtle" },

  // ─── Agent ────────────────────────────────────────────
  "agent": {
    "tool_permissions": { "default": "allow" },
    "default_model": {
      "provider": "zed.dev",
      "model": "gpt-5.4",
      "effort": "medium",
      "enable_thinking": true,
    },
  },

  // ─── Languages ────────────────────────────────────────
  "languages": {
    "Ruby": {
      "tab_size": 2,
      "formatter": "language_server",
      "preferred_line_length": 120,
      "soft_wrap": "preferred_line_length",
      "language_servers": ["ruby-lsp", "!solargraph", "rubocop", "!sorbet"],
    },
    "TypeScript": {
      "language_servers": ["typescript-language-server", "!vtsls"],
      "formatter": "prettier",
      "code_actions_on_format": {
        "source.organizeImports": true,
        "source.fixAll.eslint": true,
      },
    },
    "TSX": {
      "tab_size": 2,
      "formatter": "prettier",
      "language_servers": ["typescript-language-server", "eslint", "tailwindcss-language-server"],
    },
  },

  // ─── LSP ──────────────────────────────────────────────
  "lsp": {
    "typescript-language-server": {
      "initialization_options": {
        "preferences": {
          "includeInlayParameterNameHints": "none",
          "includeInlayFunctionParameterTypeHints": true,
          "includeInlayVariableTypeHints": false,
          "includeInlayPropertyDeclarationTypeHints": true,
          "includeInlayFunctionLikeReturnTypeHints": true,
          "includeInlayEnumMemberValueHints": true,
          "importModuleSpecifierPreference": "shortest",
          "quotePreference": "single",
        },
        "tsserver": { "maxTsServerMemory": 8192 },
      },
    },
    "ruby-lsp": {
      "initialization_options": {
        "enabledFeatures": {
          "diagnostics": true,
          "formatting": true,
          "semanticHighlighting": false,
          "debugging": true,
        },
        "formatter": "rubocop",
        "featuresConfiguration": {
          "inlayHint": { "enableAll": false },
          "debugging": { "enabled": true, "attachMode": "remote", "remotePort": 38698 },
        },
        "rubyVersionManager": { "identifier": "auto" },
      },
    },
  },

  // ─── File Scan Exclusions ─────────────────────────────
  "file_scan_exclusions": [
    "**/.git", "**/.svn", "**/.hg", "**/CVS",
    "**/.DS_Store", "**/Thumbs.db", "**/.classpath", "**/.settings",
    "**/out", "**/dist", "**/.husky", "**/.turbo",
    "**/.vscode-test", "**/.vscode", "**/.next",
    "**/.storybook", "**/.tap", "**/.nyc_output",
    "**/report", "**/node_modules",
  ],
}
