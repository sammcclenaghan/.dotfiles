      "args": [],
      "projects": [
        {
          "paths": ["/home/sammcclenaghan"],
        },
      ],
    },
  ],
  "edit_predictions": {
    "mode": "subtle",
  },
  "file_finder": {
    "modal_max_width": "medium",
  },
  "ui_font_family": "JetBrains Mono",
  "outline_panel": {
    "button": false,
  },
  "active_pane_modifiers": {
    "border_size": 0.0,
  },
  "zoomed_padding": true,
  "use_system_window_tabs": false,
  "bottom_dock_layout": "contained",
  "tab_bar": {
    "show_nav_history_buttons": true,
    "show": false,
  },
  "title_bar": {
    "show_menus": false,
    "show_sign_in": false,
    "show_user_picture": false,
    "show_onboarding_banner": true,
  },
  "terminal": {
    "button": false,
  },
  "search": {
    "button": false,
  },
  "debugger": {
    "button": false,
  },
  "status_bar": {
    "cursor_position_button": false,
    "active_language_button": true,
  },
  "project_panel": {
    "indent_size": 15.0,
    "entry_spacing": "standard",
    "button": true,
  },
  "diagnostics": {
    "inline": {
      "padding": 15,
      "enabled": true,
    },
  },
  "soft_wrap": "none",
  "toolbar": {
    "selections_menu": true,
    "quick_actions": false,
  },
  "scrollbar": {
    "axes": {
      "vertical": false,
    },
    "show": "never",
  },
  "gutter": {
    "min_line_number_digits": 5,
    "breakpoints": false,
    "runnables": true,
  },
  "relative_line_numbers": "enabled",
  "hover_popover_delay": 300,
  "snippet_sort_order": "inline",
  "unnecessary_code_fade": 0.4000000059604645,
  "context_servers": {},
  "inlay_hints": {
    "enabled": true,
    "show_value_hints": true,
    "show_type_hints": true,
    "show_parameter_hints": true,
    "show_other_hints": true,
    "show_background": true,
    "edit_debounce_ms": 700,
    "scroll_debounce_ms": 50,
    "toggle_on_modifiers_press": {
      "control": false,
      "alt": false,
      "shift": false,
      "platform": false,
      "function": false,
    },
  },
  "base_keymap": "VSCode",
  "agent": {
    "default_profile": "write",
    "profiles": {
      "plan": {
        "name": "Plan",
        "tools": {
          "diagnostics": true,
          "fetch": true,
          "find_path": true,
          "grep": true,
          "list_directory": true,
          "now": true,
          "open": true,
          "read_file": true,
          "terminal": true,
          "web_search": true,
          "create_directory": false
        },
        "enable_all_context_servers": false,
        "context_servers": {}
      },
      "write": {
        "name": "Write",
        "tools": {},
        "enable_all_context_servers": false,
        "context_servers": {}
      }
    },
    "always_allow_tool_actions": true,
    "favorite_models": [
      {
        "provider": "copilot_chat",
        "model": "gpt-5-mini",
      },
      {
        "provider": "copilot_chat",
        "model": "claude-opus-4.5",
      },
    ],
    "default_model": {
      "effort": "medium",
      "enable_thinking": true,
      "provider": "zed.dev",
      "model": "gpt-5.4",
    },
    "model_parameters": [],
  },
  "features": {
    "edit_prediction_provider": "zed",
  },
  "buffer_font_family": "JetBrains Mono",
  "theme": "Base16 Gruvbox dark, soft",
  "tab_size": 2,
  "format_on_save": "on",
  "ui_font_size": 14.0,
  "buffer_font_size": 13.0,
  "languages": {
    "Ruby": {
      "tab_size": 2,
      "formatter": "language_server",
      "preferred_line_length": 120,
      "soft_wrap": "preferred_line_length",
      "language_servers": ["ruby-lsp", "!solargraph", "rubocop", "!sorbet"],
    },
    "TypeScript": {
      "language_servers": ["typescript-language-server", "!vtsls", "..."],
      "formatter": "prettier",
      "code_actions_on_format": {
        "source.organizeImports": true,
        "source.fixAll.eslint": true,
      },
    },
    "TSX": {
      "tab_size": 2,
      "formatter": "prettier",
      "language_servers": [
        "typescript-language-server",
        "eslint",
        "tailwindcss-language-server",
      ],
    },
  },
  "lsp": {
    "typescript-language-server": {
      "initialization_options": {
        "preferences": {
          "includeInlayParameterNameHints": "none",
          "includeInlayFunctionParameterTypeHints": true,
          "includeInlayVariableTypeHints": false,
          "includeInlayPropertyDeclarationTypeHints": true,
          "includeInlayFunctionLikeReturnTypeHints": true,
          "includeInlayEnumMemberValueHints": true,
          "importModuleSpecifierPreference": "shortest",
          "quotePreference": "single",
        },
        "tsserver": {
          "maxTsServerMemory": 8192,
        },
      },
    },
    "ruby-lsp": {
      "initialization_options": {
        "enabledFeatures": {
          "diagnostics": true,
          "formatting": true,
          "semanticHighlighting": false,
          "debugging": true,
        },
        "formatter": "rubocop",
        "featuresConfiguration": {
          "inlayHint": {
            "enableAll": false,
          },
          "debugging": {
            "enabled": true,
            "attachMode": "remote",
            "remotePort": 38698,
          },
        },
        "rubyVersionManager": {
          "identifier": "auto",
        },
      },
    },
  },
  "vim_mode": true,
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
    // above is default from Zed
    "**/out",
    "**/dist",
    "**/.husky",
    "**/.turbo",
    "**/.vscode-test",
    "**/.vscode",
    "**/.next",
    "**/.storybook",
    "**/.tap",
    "**/.nyc_output",
    "**/report",
    "**/node_modules",
  ],
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
}
