[init]
  defaultBranch = main
[push]
  autoSetupRemote = true
[diff]
  algorithm = histogram
[branch]
  sort = committerdate
[commit]
  verbose = true
[help]
  autocorrect = prompt
[alias]
  undo = reset --soft HEAD~1
  ls = status
[rerere]
  enabled = true
